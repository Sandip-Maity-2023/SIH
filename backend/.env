# Node Environment
NODE_ENV=development
PORT=5000

# Database Connection (MongoDB)
MONGO_URI=mongodb://127.0.0.1:27017/agridirect

# Authentication
JWT_SECRET=your_super_secret_jwt_key_agridirect_2026
JWT_EXPIRE=30d

# Socket.io & CORS Configuration
CLIENT_URL=http://localhost:3000

# Optional: AI / VRP Service Endpoints (if running external Python models)
AI_QUALITY_SERVICE_URL=http://127.0.0.1:8000/predict
VRP_OPTIMIZER_SERVICE_URL=http://127.0.0.1:8000/optimize-route


